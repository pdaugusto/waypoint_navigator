<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>waypoint_navigator</name>
  <version>1.0.0</version>
  <description>
    ROS2 autonomous waypoint navigation package.
    Executes a sequence of goals via Nav2 and returns to the starting position.
  </description>

  <maintainer email="seu@email.com">Seu Nome</maintainer>
  <license>MIT</license>

  <!-- Dependências de build -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Dependências de execução -->
  <depend>rclpy</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <!-- Dependências de launch -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>